{
    "metadata": {
        "check_id": "COMPOSER-C0009",
        "module": "composer",
        "name": "Report a Composer self-check failure without guessing its cause",
        "summary": "Report a Composer self-check failure without guessing its cause.",
        "severity": "MEDIUM",
        "version": "1.0.0",
        "tags": [
            "composer",
            "composer-self-check-failure"
        ]
    },
    "supports": [],
    "requires_commands": [
        "composer"
    ],
    "probe": {
        "type": "command",
        "command": [
            "composer",
            "diagnose",
            "--no-interaction"
