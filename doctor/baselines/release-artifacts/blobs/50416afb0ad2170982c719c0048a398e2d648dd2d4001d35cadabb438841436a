Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^doctor$ doctor/ [R=302,L]
    RewriteRule ^(?:config|classes|controllers|cron|database|models|packaging|scripts|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^storage(?:/|$) - [F,L,NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(env|ini|log|sql|bak|md|lock|json)$">
    Require all denied
</FilesMatch>
