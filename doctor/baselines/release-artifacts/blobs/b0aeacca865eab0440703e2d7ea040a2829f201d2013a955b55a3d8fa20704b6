:root {
    --sys-border: #d9e2ea;
    --sys-bg: #eef3f6;
    --sys-output: #0f172a;
    --lp-ink: #17191f;
    --lp-ink-soft: #252a31;
    --lp-panel: #ffffff;
    --lp-muted: #64717f;
    --lp-teal: #0f766e;
    --lp-cyan: #0891b2;
    --lp-amber: #d97706;
    --lp-rose: #be123c;
    --lp-green: #15803d;
    --lp-violet: #7c3aed;
}

body {
    letter-spacing: 0;
    background: var(--sys-bg);
    color: #172033;
}

.content-wrapper {
    background: var(--sys-bg);
}

.microsysadmin-shell .wrapper {
    background: var(--sys-bg);
}

.lp-topbar {
    border-bottom: 1px solid rgba(23, 25, 31, .08);
    background: rgba(255, 255, 255, .94) !important;
    backdrop-filter: blur(12px);
}

.lp-host-pill {
    align-items: center;
    gap: .5rem;
    min-height: 32px;
    padding: 0 .75rem;
    border: 1px solid #dbe4ec;
    border-radius: 999px;
    background: #f7fafc;
    color: #475569;
    font-size: .82rem;
    font-weight: 700;
}

.lp-host-dot {
    width: .55rem;
    height: .55rem;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, .14);
}

.lp-host-divider {
    width: 1px;
    height: 16px;
    background: #d1dbe5;
}

.lp-sidebar {
    background: linear-gradient(180deg, #181b20 0%, #202226 58%, #151719 100%) !important;
    box-shadow: 8px 0 24px rgba(17, 24, 39, .18);
}

.lp-brand {
    display: flex;
    align-items: center;
    gap: .75rem;
    min-height: 68px;
    border-bottom: 1px solid rgba(255, 255, 255, .08) !important;
    background: rgba(255, 255, 255, .04);
}

.lp-brand-mark {
    display: inline-grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 8px;
    background: linear-gradient(135deg, #16a34a, #0891b2 55%, #f59e0b);
    color: #fff;
    box-shadow: 0 10px 24px rgba(8, 145, 178, .28);
}

.lp-brand .brand-text {
    display: grid;
    gap: .05rem;
    line-height: 1.1;
    color: #f8fafc;
    font-weight: 800 !important;
}

.lp-brand small {
    color: #aab6c2;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.main-sidebar .nav-header {
    margin-top: .55rem;
    color: #8fa0ad;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .08em;
}

.main-sidebar .nav-sidebar .nav-link {
    min-height: 36px;
    margin: .08rem .55rem;
    border-radius: 7px;
    color: #d7dee7;
}

.main-sidebar .nav-sidebar .nav-link:hover,
.main-sidebar .nav-sidebar .nav-link:focus {
    background: rgba(255, 255, 255, .08);
    color: #fff;
}

.main-sidebar .nav-sidebar .nav-link.active {
    background: linear-gradient(135deg, #0f766e, #256f8d) !important;
    color: #fff;
    box-shadow: 0 10px 20px rgba(15, 118, 110, .22);
}

.main-sidebar .nav-icon {
    color: inherit;
}

.content-header {
    padding-top: 1.35rem;
}

.lp-page-kicker {
    margin-bottom: .15rem;
    color: var(--lp-teal);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.content-header h1 {
    color: #111827;
    font-size: 1.62rem;
    font-weight: 850;
}

.lp-action-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .9rem 1rem;
    border: 1px solid var(--sys-border);
    border-radius: 8px;
    background: linear-gradient(135deg, #ffffff, #f8fbfd);
    box-shadow: 0 12px 28px rgba(15, 23, 42, .06);
}

.lp-action-strip strong {
    display: block;
    color: #111827;
    font-size: 1rem;
}

.lp-action-strip span {
    color: var(--lp-muted);
    font-size: .82rem;
}

.lp-action-strip-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .45rem;
}

.sys-sidebar-action {
    position: sticky;
    top: .5rem;
    z-index: 3;
    padding: .5rem 0 .35rem;
    background: linear-gradient(180deg, rgba(24, 27, 32, .96), rgba(24, 27, 32, .82));
}

.sys-sidebar-refresh {
    width: 100%;
    border: 0;
    color: #c2c7d0;
    text-align: left;
}

.sys-sidebar-refresh:hover,
.sys-sidebar-refresh:focus {
    color: #fff;
    background: rgba(255, 255, 255, .08);
}

.sys-sidebar-refresh.is-refreshing .fa-arrows-rotate {
    animation: sys-spin .75s linear infinite;
}

@keyframes sys-spin {
    to {
        transform: rotate(360deg);
    }
}

@media (min-width: 768px) {
    .content-wrapper {
        margin-left: 0 !important;
        padding-left: 250px !important;
    }

    .main-footer,
    .main-header {
        margin-left: 250px !important;
    }

    .content-wrapper > .content-header,
    .content-wrapper > .content {
        padding-left: 2rem;
    }
}

@media (max-width: 767.98px) {
    .content-wrapper,
    .main-footer,
    .main-header {
        margin-left: 0;
        padding-left: 0 !important;
    }

    .lp-action-strip {
        align-items: flex-start;
        flex-direction: column;
    }

    .lp-action-strip-actions {
        justify-content: flex-start;
        width: 100%;
    }
}

.card {
    border-radius: 8px;
    border: 1px solid var(--sys-border);
    box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
}

.card-header {
    border-bottom-color: #e5edf4;
    background: linear-gradient(180deg, #ffffff, #f8fafc);
}

.btn {
    border-radius: 6px;
    font-weight: 700;
}

.btn-primary,
.bg-primary {
    border-color: var(--lp-teal) !important;
    background-color: var(--lp-teal) !important;
}

.btn-outline-primary {
    border-color: var(--lp-teal);
    color: var(--lp-teal);
}

.btn-outline-primary:hover,
.btn-outline-primary:focus {
    border-color: var(--lp-teal);
    background: var(--lp-teal);
    color: #fff;
}

.sys-metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
    gap: 1rem;
}

.sys-metric-grid .small-box {
    position: relative;
    min-height: 112px;
    margin-bottom: 0;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 14px 30px rgba(15, 23, 42, .12);
}

.sys-metric-grid .small-box::after {
    content: "";
    position: absolute;
    right: -22px;
    bottom: -28px;
    width: 96px;
    height: 96px;
    border: 1px solid rgba(255, 255, 255, .28);
    border-radius: 16px;
    transform: rotate(14deg);
}

.sys-metric-grid .small-box.bg-primary {
    background: linear-gradient(135deg, #0f766e, #0891b2) !important;
}

.sys-metric-grid .small-box.bg-success {
    background: linear-gradient(135deg, #15803d, #65a30d) !important;
}

.sys-metric-grid .small-box.bg-warning {
    background: linear-gradient(135deg, #d97706, #eab308) !important;
    color: #111827 !important;
}

.sys-metric-grid .small-box.bg-danger {
    background: linear-gradient(135deg, #be123c, #e11d48) !important;
}

.sys-metric-grid .small-box.bg-info {
    background: linear-gradient(135deg, #0891b2, #7c3aed) !important;
}

.sys-metric-grid .small-box.bg-secondary {
    background: linear-gradient(135deg, #475569, #334155) !important;
}

.sys-metric-grid .small-box.bg-dark {
    background: linear-gradient(135deg, #17191f, #2f343b) !important;
}

.sys-metric-link {
    color: inherit;
    display: block;
    text-decoration: none;
    transition: transform .12s ease, box-shadow .12s ease;
}

.sys-metric-link:hover,
.sys-metric-link:focus {
    color: inherit;
    text-decoration: none;
    transform: translateY(-1px);
    box-shadow: 0 .5rem 1rem rgba(15, 23, 42, .18);
}

.sys-metric-grid .small-box h3 {
    font-size: clamp(1.6rem, 2vw, 2.1rem);
    white-space: normal;
    font-weight: 850;
}

.card-title {
    font-size: 1rem;
    font-weight: 700;
}

.service-action-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(74px, 1fr));
    gap: .35rem;
    min-width: 420px;
}

.service-action-grid .btn {
    white-space: nowrap;
}

.sys-output {
    min-height: 110px;
    max-height: 440px;
    overflow: auto;
    margin: 0;
    padding: .85rem;
    border-radius: .4rem;
    background: var(--sys-output);
    color: #dbeafe;
    font-size: .82rem;
    white-space: pre-wrap;
}

.sys-output.compact {
    min-height: 42px;
    max-height: 110px;
    padding: .4rem;
    font-size: .75rem;
}

.sandbox-tabs .nav-link {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
}

.sandbox-editor {
    min-height: 430px;
    resize: vertical;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .86rem;
    line-height: 1.45;
    tab-size: 4;
    white-space: pre;
}

.sandbox-stdin {
    min-height: 94px;
    resize: vertical;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .84rem;
}

.sandbox-paths {
    display: grid;
    gap: .35rem;
    color: #526071;
    font-size: .8rem;
}

.sandbox-paths span {
    min-width: 0;
}

.sandbox-paths code {
    color: #26364c;
    overflow-wrap: anywhere;
}

.sandbox-current-path {
    display: flex;
    align-items: center;
    gap: .4rem;
    min-width: 0;
    color: #526071;
    font-size: .82rem;
}

.sandbox-current-path code {
    color: #26364c;
    overflow-wrap: anywhere;
}

.sandbox-output {
    min-height: 612px;
    border-radius: 0 0 .4rem .4rem;
}

.sandbox-terminal {
    height: 612px;
    min-height: 420px;
    padding: .35rem;
    overflow: hidden;
    border-radius: 0 0 .4rem .4rem;
    background: #0f172a;
}

.sandbox-terminal .xterm {
    height: 100%;
}

.sandbox-terminal .xterm-viewport,
.sandbox-terminal .xterm-screen {
    border-radius: .25rem;
}

.sandbox-terminal-state {
    min-width: 68px;
    color: #526071;
    font-size: .8rem;
    text-align: right;
}

.sandbox-terminal-fallback {
    min-height: 612px;
    border-radius: 0 0 .4rem .4rem;
}

body.sandbox-terminal-fullscreen {
    overflow: hidden;
}

.sandbox-terminal-card.is-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 1060;
    display: flex;
    flex-direction: column;
    margin: 0;
    border-radius: 0;
    background: #fff;
}

.sandbox-terminal-card.is-fullscreen .card-header {
    flex: 0 0 auto;
}

.sandbox-terminal-card.is-fullscreen .card-body {
    flex: 1 1 auto;
    min-height: 0;
}

.sandbox-terminal-card.is-fullscreen .sandbox-terminal,
.sandbox-terminal-card.is-fullscreen .sandbox-terminal-fallback {
    height: 100%;
    min-height: 0;
    border-radius: 0;
}

.sandbox-frame {
    width: 100%;
    min-height: 520px;
    border: 0;
    background: #fff;
}

.sandbox-php-output {
    min-height: 612px;
}

.log-window {
    height: 620px;
    overflow: auto;
    padding: .75rem;
    border-radius: .4rem;
    background: #101827;
    color: #e5edf7;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .82rem;
}

.log-line {
    border-bottom: 1px solid rgba(255,255,255,.06);
    padding: .12rem 0;
}

.log-error {
    color: #fecaca;
    background: rgba(185, 28, 28, .22);
}

.log-warning {
    color: #fde68a;
}

.file-manager .js-file-row {
    cursor: pointer;
}

.file-manager .js-file-row.selected {
    background: #dbeafe;
}

.file-manager #selectedPathLabel {
    display: inline-block;
    max-width: 100%;
    white-space: normal;
    word-break: break-all;
}

.sys-search-result {
    text-decoration: none;
}

.sys-search-result code {
    color: #0d6efd;
    white-space: normal;
    word-break: break-all;
}

.sys-search-result:hover code,
.sys-search-result:focus code {
    text-decoration: underline;
}

.file-manager td .btn-xs {
    margin: .08rem;
}

.hosting-path {
    display: inline-block;
    max-width: 100%;
    white-space: normal;
    word-break: break-all;
}

.hosting-site-table td {
    vertical-align: middle;
}

.site-pages-list {
    display: grid;
    gap: .45rem;
    max-height: 58vh;
    overflow: auto;
}

.site-page-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: .75rem;
    padding: .6rem;
    border: 1px solid var(--sys-border);
    border-radius: 8px;
    background: #fff;
}

.site-page-row.is-active {
    border-color: #0d6efd;
    background: #f5f9ff;
    box-shadow: inset 3px 0 0 #0d6efd;
}

.site-page-main {
    min-width: 0;
}

.site-page-select {
    display: block;
    flex: 1 1 auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
}

.site-page-select > span,
.site-page-select > code {
    display: block;
}

.site-page-select:focus-visible {
    outline: 2px solid #0d6efd;
    outline-offset: 3px;
}

.site-page-main code,
.site-page-actions {
    overflow-wrap: anywhere;
}

.site-page-actions {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .25rem;
}

.site-page-editor textarea.site-blade-editor {
    min-height: 58vh;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .84rem;
    line-height: 1.45;
    white-space: pre;
}

.site-page-editor {
    scroll-margin-top: .5rem;
}

.site-page-editor-toolbar {
    flex-wrap: wrap;
}

.site-page-editor-heading {
    flex: 1 1 18rem;
    min-width: 0;
}

.site-page-editor-heading code {
    display: block;
    overflow-wrap: anywhere;
}

.site-page-editor-save {
    flex-shrink: 0;
    white-space: nowrap;
}

.site-page-create-content {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .82rem;
}

.site-pages-empty {
    display: grid;
    min-height: 58vh;
    place-items: center;
    border: 1px dashed var(--sys-border);
    border-radius: 8px;
    color: var(--lp-muted);
}

@media (max-width: 991.98px) {
    .site-page-row {
        align-items: stretch;
        flex-direction: column;
    }

    .site-page-actions {
        justify-content: flex-start;
    }

    .site-page-editor textarea.site-blade-editor,
    .site-pages-empty {
        min-height: 50vh;
    }
}

.site-artisan-quick {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--sys-border);
}

.site-artisan-runner {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--sys-border);
}

.site-artisan-runner .input-group-text,
.site-artisan-runner input {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

.site-artisan-output-wrap {
    padding: 1rem 1.25rem 1.25rem;
}

.site-artisan-output {
    min-height: 220px;
    max-height: 50vh;
}

@media (max-width: 575.98px) {
    .site-artisan-quick {
        align-items: stretch;
        flex-direction: column;
    }

    .site-artisan-quick .btn,
    .site-artisan-runner .btn {
        width: 100%;
    }

    .site-artisan-runner .input-group {
        display: grid;
        grid-template-columns: 1fr;
    }

    .site-artisan-runner .input-group > * {
        width: 100%;
        border-radius: .25rem !important;
    }
}

#filePreview img {
    max-width: 100%;
    height: auto;
    border-radius: .4rem;
}

.file-preview-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: .35rem;
    margin-bottom: .5rem;
}

.swal2-textarea.sys-file-editor {
    min-height: 48vh !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .86rem !important;
    line-height: 1.45;
    white-space: pre;
}

.login-page {
    min-height: 100vh;
}

.sysadmin-login {
    background: linear-gradient(135deg, #e9f1fb, #f8fafc);
}

.dark-mode .content-wrapper {
    background: #111827;
}

.dark-mode .card {
    background: #1f2937;
    border-color: #374151;
}

.dark-mode .table {
    color: #e5e7eb;
}

.mysql-field-grid {
    display: grid;
    gap: .85rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
}

.mysql-field-type {
    color: #6b7280;
    font-size: .78rem;
}

.mysql-modal-context {
    margin-top: .1rem;
    color: #64748b;
    font-size: .82rem;
}

.mysql-field {
    padding: .85rem;
    border: 1px solid var(--sys-border);
    border-radius: .45rem;
    background: #f8fafc;
}

.mysql-field-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: .75rem;
    margin-bottom: .55rem;
}

.mysql-field-label {
    display: block;
    margin: 0;
    color: #111827;
    font-size: .94rem;
    font-weight: 700;
}

.mysql-field-column {
    margin-top: .12rem;
    color: #64748b;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .73rem;
}

.mysql-field-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: .25rem;
    max-width: 46%;
}

.mysql-field-chip {
    display: inline-flex;
    align-items: center;
    min-height: 20px;
    padding: .08rem .4rem;
    border: 1px solid #cbd5e1;
    border-radius: 999px;
    background: #fff;
    color: #475569;
    font-size: .7rem;
    font-weight: 700;
    white-space: nowrap;
}

.mysql-field-chip-lock {
    border-color: #bfdbfe;
    background: #eff6ff;
    color: #1d4ed8;
}

.mysql-field-readonly {
    background: #f1f5f9;
}

.mysql-field.is-null {
    background: #f8fafc;
}

.mysql-field.is-null .form-control,
.mysql-field.is-null .form-select {
    opacity: .6;
}

.mysql-field-textarea {
    min-height: 92px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .84rem;
}

.mysql-field-json .mysql-field-textarea,
.mysql-field-long-text .mysql-field-textarea {
    min-height: 132px;
}

.mysql-null-switch {
    margin-top: .55rem;
    color: #475569;
    font-size: .82rem;
}

.mysql-null-switch .form-check-input {
    cursor: pointer;
}

.dark-mode .mysql-field-type {
    color: #cbd5e1;
}

.dark-mode .mysql-modal-context,
.dark-mode .mysql-field-column,
.dark-mode .mysql-null-switch {
    color: #cbd5e1;
}

.dark-mode .mysql-field {
    background: #111827;
    border-color: #374151;
}

.dark-mode .mysql-field-readonly,
.dark-mode .mysql-field.is-null {
    background: #172033;
}

.dark-mode .mysql-field-label {
    color: #f8fafc;
}

.dark-mode .mysql-field-chip {
    background: #1f2937;
    border-color: #475569;
    color: #e5e7eb;
}

.dark-mode .mysql-field-chip-lock {
    background: #1e3a8a;
    border-color: #3b82f6;
    color: #dbeafe;
}

@media (max-width: 575.98px) {
    .mysql-field-header {
        flex-direction: column;
    }

    .mysql-field-badges {
        justify-content: flex-start;
        max-width: 100%;
    }
}

.mysql-workbench {
    padding: 1rem;
    border: 1px solid var(--sys-border);
    border-radius: .5rem;
    background: #fff;
}

.mysql-toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: .9rem;
    border-bottom: 1px solid var(--sys-border);
}

.mysql-selector {
    display: grid;
    grid-template-columns: minmax(180px, 260px) minmax(230px, 360px) auto;
    align-items: end;
    gap: .75rem;
}

.mysql-select-field {
    margin: 0;
}

.mysql-select-field span {
    display: block;
    margin-bottom: .25rem;
    color: #64748b;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
}

.mysql-toolbar-actions {
    position: relative;
    display: flex;
    align-items: center;
    gap: .5rem;
}

.mysql-transfer {
    position: relative;
}

.mysql-transfer summary {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    min-height: 31px;
    padding: .25rem .65rem;
    border: 1px solid #6c757d;
    border-radius: .25rem;
    color: #495057;
    cursor: pointer;
    font-size: .875rem;
    line-height: 1.5;
    list-style: none;
    user-select: none;
}

.mysql-transfer summary::-webkit-details-marker {
    display: none;
}

.mysql-transfer summary:hover,
.mysql-transfer[open] summary {
    background: #f8fafc;
}

.mysql-transfer-menu {
    position: absolute;
    top: calc(100% + .45rem);
    right: 0;
    z-index: 20;
    width: min(320px, calc(100vw - 2rem));
    padding: .75rem;
    border: 1px solid var(--sys-border);
    border-radius: .45rem;
    background: #fff;
    box-shadow: 0 .8rem 2rem rgba(15, 23, 42, .18);
}

.mysql-context {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem;
    padding: .8rem 0;
    color: #64748b;
    font-size: .86rem;
}

.mysql-database-overview {
    display: grid;
    grid-template-columns: minmax(220px, 1fr) minmax(360px, 1.5fr);
    gap: 1rem;
    margin-top: 1rem;
    padding: .9rem 1rem;
    border: 1px solid var(--sys-border);
    border-radius: .45rem;
    background: #f8fafc;
}

.mysql-database-overview-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
}

.mysql-database-overview-heading div > span,
.mysql-database-metrics span {
    display: block;
    color: #64748b;
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
}

.mysql-database-overview-heading strong {
    display: block;
    margin-top: .15rem;
    color: #111827;
    font-size: 1.05rem;
}

.mysql-database-status {
    color: #15803d;
    font-size: .8rem;
    font-weight: 700;
    white-space: nowrap;
}

.mysql-database-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .75rem;
}

.mysql-database-metrics div {
    padding-left: .75rem;
    border-left: 1px solid var(--sys-border);
}

.mysql-database-metrics strong {
    display: block;
    color: #111827;
    font-size: 1rem;
}

.mysql-context strong {
    color: #111827;
    font-size: .95rem;
}

.mysql-context span:not(:first-child) {
    padding-left: .5rem;
    border-left: 1px solid var(--sys-border);
}

.mysql-empty-state {
    padding: 2rem;
    border: 1px dashed var(--sys-border);
    border-radius: .45rem;
    color: #64748b;
    text-align: center;
}

.mysql-empty-state-inline {
    display: flex;
    flex-direction: column;
    gap: .25rem;
    margin-bottom: .75rem;
    padding: 1rem;
}

.mysql-empty-state-inline strong {
    color: #334155;
}

.mysql-grid-shell {
    overflow: hidden;
}

.mysql-output-panel {
    margin-top: .75rem;
}

.mysql-crud-table {
    width: 100% !important;
    margin-bottom: 0 !important;
    table-layout: auto;
}

.mysql-crud-table th,
.mysql-crud-table td {
    vertical-align: middle;
    white-space: nowrap;
}

.mysql-crud-table td {
    max-width: 320px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mysql-crud-table th {
    background: #f8fafc;
    color: #334155;
    font-size: .76rem;
    font-weight: 700;
    text-transform: uppercase;
}

.mysql-crud-table-has-actions .mysql-row-actions,
.mysql-crud-table-has-actions th:first-child {
    position: sticky;
    left: 0;
    z-index: 2;
    min-width: 142px;
    background: #fff;
    box-shadow: 1px 0 0 var(--sys-border);
    white-space: nowrap;
}

.mysql-crud-table-has-actions th:first-child {
    background: #f8fafc;
    z-index: 3;
}

.mysql-row-actions .btn {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    padding: .16rem .45rem;
    line-height: 1.2;
}

.dt-container .dt-layout-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin: 0 0 .75rem;
}

.dt-container .dt-layout-cell {
    display: flex;
    align-items: center;
}

.dt-container .dt-search,
.dt-container .dt-length {
    display: flex;
    align-items: center;
    gap: .45rem;
    margin: 0;
}

.dt-container .dt-search input,
.dt-container .dt-length select {
    min-height: 32px;
}

.dt-container .dt-scroll-body {
    border: 1px solid var(--sys-border);
    border-radius: .4rem;
}

.dt-container .dt-info,
.dt-container .dt-paging {
    font-size: .82rem;
}

@media (max-width: 991.98px) {
    .mysql-database-overview {
        grid-template-columns: 1fr;
    }

    .mysql-toolbar {
        align-items: stretch;
        flex-direction: column;
    }

    .mysql-selector {
        grid-template-columns: 1fr;
    }

    .mysql-toolbar-actions {
        align-items: stretch;
        flex-direction: column;
    }

    .mysql-transfer-menu {
        left: 0;
        right: auto;
    }
}

@media (max-width: 767.98px) {
    .mysql-database-metrics {
        grid-template-columns: 1fr;
    }

    .mysql-database-metrics div {
        padding: .5rem 0 0;
        border-top: 1px solid var(--sys-border);
        border-left: 0;
    }

    .dt-container .dt-layout-row {
        align-items: stretch;
        flex-direction: column;
    }

    .dt-container .dt-layout-cell,
    .dt-container .dt-search,
    .dt-container .dt-length {
        width: 100%;
    }

    .dt-container .dt-search input,
    .dt-container .dt-length select {
        width: 100%;
    }
}

.dark-mode .mysql-workbench,
.dark-mode .mysql-transfer-menu {
    background: #1f2937;
    border-color: #374151;
}

.dark-mode .mysql-database-overview {
    background: #111827;
    border-color: #374151;
}

.dark-mode .mysql-database-overview-heading strong,
.dark-mode .mysql-database-metrics strong,
.dark-mode .mysql-empty-state-inline strong {
    color: #f8fafc;
}

.dark-mode .mysql-database-overview-heading div > span,
.dark-mode .mysql-database-metrics span {
    color: #cbd5e1;
}

.dark-mode .mysql-select-field span,
.dark-mode .mysql-context {
    color: #cbd5e1;
}

.dark-mode .mysql-context strong {
    color: #f8fafc;
}

.dark-mode .mysql-transfer summary {
    color: #e5e7eb;
    border-color: #64748b;
}

.dark-mode .mysql-transfer summary:hover,
.dark-mode .mysql-transfer[open] summary {
    background: #111827;
}

.dark-mode .mysql-crud-table th,
.dark-mode .mysql-crud-table th:first-child {
    background: #111827;
    color: #e5e7eb;
}

.dark-mode .mysql-crud-table .mysql-row-actions {
    background: #1f2937;
}
body.theme-blue {
    --lp-accent: #2563eb;
}

body.theme-green {
    --lp-accent: #15803d;
}

body.theme-blue .main-sidebar,
body.theme-green .main-sidebar {
    border-top: 3px solid var(--lp-accent);
}

body.theme-blue .btn-primary,
body.theme-green .btn-primary {
    background-color: var(--lp-accent);
    border-color: var(--lp-accent);
}

.doctor-heading .container-fluid {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
}

.doctor-heading h1 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -.035em;
}

.doctor-heading p {
    margin: .35rem 0 0;
    color: #64748b;
}

.doctor-eyebrow {
    display: block;
    color: #2563eb;
    font-size: .68rem;
    font-weight: 800;
    letter-spacing: .12em;
}

.doctor-library-count {
    display: flex;
    flex-direction: column;
    padding: .6rem 1rem;
    border: 1px solid #bfdbfe;
    border-radius: .75rem;
    background: #eff6ff;
    text-align: right;
}

.doctor-library-count strong { color: #1d4ed8; font-size: 1.4rem; line-height: 1; }
.doctor-library-count span { color: #475569; font-size: .72rem; margin-top: .2rem; }

.doctor-stat-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: .75rem;
    margin-bottom: 1rem;
}

.doctor-stat {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .9rem 1rem;
    border: 1px solid var(--sys-border);
    border-radius: .65rem;
    background: #fff;
}

.doctor-stat > i { color: #2563eb; font-size: 1.2rem; }
.doctor-stat div { display: flex; flex-direction: column; min-width: 0; }
.doctor-stat strong { color: #0f172a; font-size: 1.25rem; line-height: 1.1; }
.doctor-stat span { color: #64748b; font-size: .72rem; text-transform: uppercase; }

.doctor-command-form {
    display: grid;
    grid-template-columns: minmax(260px, 2fr) minmax(180px, 1fr) minmax(180px, 1fr);
    gap: .85rem;
    align-items: end;
}

.doctor-command-field label { display: block; margin-bottom: .25rem; color: #475569; font-size: .75rem; font-weight: 700; }
.doctor-command-actions { display: flex; grid-column: 1 / -1; flex-wrap: wrap; gap: .5rem; }
.doctor-command-actions .btn { display: inline-flex; align-items: center; gap: .4rem; }
.doctor-command-actions .doctor-fix-all { padding-inline: 1.1rem; font-weight: 800; box-shadow: 0 .35rem .9rem rgba(22, 163, 74, .2); }
.doctor-fix-all-help { grid-column: 1 / -1; margin: 0; color: #64748b; font-size: .76rem; }
.doctor-fix-all-help i, .doctor-plan-guidance i { margin-right: .3rem; color: #16a34a; }
.doctor-plan-guidance { margin: .9rem 0 0; color: #64748b; font-size: .78rem; }
.doctor-fix-summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; padding: .9rem 1rem; border: 1px solid #86efac; border-left: 4px solid #16a34a; border-radius: .65rem; background: #f0fdf4; }
.doctor-fix-summary > div > strong { display: block; margin-top: .2rem; color: #166534; }
.doctor-fix-summary dl { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; }
.doctor-fix-summary dl div { min-width: 72px; padding: .35rem .55rem; border-radius: .45rem; background: rgba(255, 255, 255, .75); text-align: center; }
.doctor-fix-summary dt { color: #64748b; font-size: .63rem; text-transform: uppercase; }
.doctor-fix-summary dd { margin: 0; color: #0f172a; font-size: 1rem; font-weight: 800; }
.doctor-fix-summary-warning { border-color: #fdba74; border-left-color: #ea580c; background: #fff7ed; }
.doctor-fix-summary-warning > div > strong { color: #9a3412; }

.doctor-health-card .card-body { display: flex; align-items: center; gap: 1rem; }
.doctor-health-card h2 { margin: .15rem 0; font-size: .9rem; font-family: ui-monospace, monospace; overflow-wrap: anywhere; }
.doctor-health-card p { margin: 0; color: #64748b; font-size: .75rem; }
.doctor-score { width: 88px; height: 88px; display: flex; flex: 0 0 88px; align-items: center; justify-content: center; flex-direction: column; border: 7px solid; border-radius: 50%; }
.doctor-score strong { font-size: 1.25rem; }
.doctor-score span { font-size: .72rem; font-weight: 700; }
.doctor-score-success { color: #15803d; border-color: #86efac; }
.doctor-score-warning { color: #a16207; border-color: #fde047; }
.doctor-score-danger { color: #b91c1c; border-color: #fca5a5; }
.doctor-health-counts { display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid var(--sys-border); }
.doctor-health-counts span { display: flex; flex-direction: column; padding: .55rem; color: #64748b; font-size: .63rem; text-align: center; }
.doctor-health-counts strong { color: #0f172a; font-size: 1rem; }

.doctor-module-health > div { display: grid; grid-template-columns: 110px 1fr 55px; gap: .75rem; align-items: center; margin-bottom: .65rem; }
.doctor-module-health .progress { height: .45rem; }
.doctor-module-health .progress-bar { background: #2563eb; }
.doctor-module-health strong { font-size: .78rem; text-align: right; }

.doctor-plan-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: .8rem; }
.doctor-plan { padding: 1rem; border: 1px solid var(--sys-border); border-radius: .65rem; background: #f8fafc; }
.doctor-plan-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
.doctor-plan h3 { margin: .7rem 0 .45rem; font-size: 1rem; font-weight: 750; }
.doctor-plan p, .doctor-plan li { color: #475569; font-size: .8rem; }
.doctor-plan pre, .doctor-result-table pre { max-height: 280px; margin: .5rem 0 0; padding: .65rem; overflow: auto; border-radius: .4rem; background: #0f172a; color: #dbeafe; font-size: .7rem; }
.doctor-plan summary, .doctor-result-table summary { color: #2563eb; cursor: pointer; font-size: .75rem; font-weight: 700; }

.doctor-status { display: inline-block; min-width: 68px; padding: .18rem .4rem; border-radius: 999px; font-size: .65rem; font-weight: 800; text-align: center; }
.doctor-status-pass { color: #166534; background: #dcfce7; }
.doctor-status-warning, .doctor-status-unknown { color: #854d0e; background: #fef9c3; }
.doctor-status-fail, .doctor-status-error { color: #991b1b; background: #fee2e2; }
.doctor-status-skipped { color: #475569; background: #e2e8f0; }
.doctor-result-table td { vertical-align: middle; }
.doctor-inventory-table td { vertical-align: middle; }

.doctor-library-filters { display: flex; flex-wrap: wrap; gap: .65rem; margin-bottom: .8rem; }
.doctor-library-filters label { min-width: 145px; color: #64748b; font-size: .7rem; font-weight: 700; text-transform: uppercase; }
.doctor-library-filters select { margin-top: .2rem; text-transform: none; }

.doctor-diagnosis-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: .75rem; }
.doctor-diagnosis-grid article, .doctor-repair-results article { padding: .8rem; border: 1px solid var(--sys-border); border-radius: .55rem; }
.doctor-diagnosis-grid strong { display: block; margin: .45rem 0; }
.doctor-diagnosis-grid p { color: #64748b; font-size: .78rem; }
.doctor-diagnosis-grid pre, .doctor-repair-results pre { max-height: 260px; margin-top: .5rem; padding: .65rem; overflow: auto; background: #0f172a; color: #dbeafe; font-size: .7rem; }
.doctor-diagnosis-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-top: .75rem; padding-top: .75rem; border-top: 1px solid var(--sys-border); }
.doctor-diagnosis-actions form { margin: 0; }
.doctor-manual-only { color: #64748b; font-size: .75rem; }
.doctor-repair-results { display: grid; gap: .65rem; }
.doctor-repair-results article { display: grid; grid-template-columns: 85px 110px 1fr; gap: .65rem; align-items: center; }
.doctor-repair-results details { grid-column: 1 / -1; }
.dark-mode .doctor-diagnosis-grid article, .dark-mode .doctor-repair-results article { border-color: #374151; }

.doctor-audit { max-height: 330px; overflow: auto; }
.doctor-audit > div { display: grid; grid-template-columns: 125px 58px 1fr; gap: .5rem; padding: .5rem 0; border-bottom: 1px solid var(--sys-border); font-size: .73rem; }
.doctor-audit p { grid-column: 3; margin: -.25rem 0 0; color: #64748b; }

.dark-mode .doctor-stat, .dark-mode .doctor-plan { background: #111827; border-color: #374151; }
.dark-mode .doctor-stat strong, .dark-mode .doctor-health-counts strong { color: #f8fafc; }
.dark-mode .doctor-heading p, .dark-mode .doctor-command-field label, .dark-mode .doctor-plan p, .dark-mode .doctor-plan li { color: #cbd5e1; }
.dark-mode .doctor-fix-all-help, .dark-mode .doctor-plan-guidance { color: #cbd5e1; }
.dark-mode .doctor-fix-summary { border-color: #166534; background: #052e16; }
.dark-mode .doctor-fix-summary dl div { background: rgba(15, 23, 42, .72); }
.dark-mode .doctor-fix-summary dd { color: #f8fafc; }
.dark-mode .doctor-fix-summary-warning { border-color: #9a3412; background: #431407; }
.dark-mode .doctor-library-count { background: #172554; border-color: #1d4ed8; }
.dark-mode .doctor-library-count span { color: #bfdbfe; }

@media (max-width: 1100px) {
    .doctor-stat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

@media (max-width: 767.98px) {
    .doctor-heading .container-fluid { align-items: stretch; flex-direction: column; }
    .doctor-library-count { text-align: left; }
    .doctor-stat-grid, .doctor-command-form { grid-template-columns: 1fr; }
    .doctor-fix-summary { align-items: stretch; flex-direction: column; }
    .doctor-command-actions { grid-column: auto; }
    .doctor-module-health > div { grid-template-columns: 90px 1fr 45px; }
    .doctor-audit > div { grid-template-columns: 1fr; }
    .doctor-audit p { grid-column: auto; }
}
