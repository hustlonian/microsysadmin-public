{
    "metadata": {
        "check_id": "GIT-C0009",
        "module": "git",
        "name": "Configure a missing repository Git author name",
        "summary": "Configure a missing repository Git author name.",
        "severity": "LOW",
        "version": "1.0.0",
        "tags": [
            "git",
            "user-name-missing"
        ]
    },
    "supports": [],
    "requires_commands": [
        "git"
    ],
    "probe": {
        "type": "command",
        "command": [
            "git",
            "config",
            "--get",
            "user.name"
        ],
        "cwd": "{PROJECT}",
        "healthy_when_path_not_writable": "{PROJECT}/.git",
        "timeout": 30
    },
    "failure_status": "WARNING"
}
